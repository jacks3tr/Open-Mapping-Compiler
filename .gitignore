# Generated suggestions are transient except the reviewed public fixtures.
**/suggestions.json
!/benchmarks/**/suggestions.json
!/examples/**/suggestions.json

# Root results are reproducible release evidence; nested local result directories are transient.
**/results/
!/results/
!/results/**

# Generated quick-start output
/examples/*/output.json
/examples/*/generated.py
/examples/*/generated.ts

# Local model settings may contain real model IDs or organization-specific routes.
**/open-mapping.models.yaml
**/open-mapping.models.yml
**/open-mapping.models.*.yaml
**/open-mapping.models.*.yml
!/examples/model-assisted/open-mapping.models.example.yaml
!/tests/golden/model_protocol/open-mapping.models.yaml

